; The ball: is the sprite on, where it should be, and moving?
run until gMLoop
check $d015 & $01 = 1      ; sprite 0 on
check $07f8 = $80          ; its data at block 128, $2000
check $d001 = #100         ; y
check $d000 = #24          ; x: the left edge
check $2000 = $00 $7e $00  ; the top row of the ball, from sprites.bin
until gMLoop               ; once round the loop: a frame
check $d000 = #25          ; a pixel to the right
