# Ultrabasic-64 (C64): its keywords and tokens, from petcat (VICE 3.7.1): petcat -wultra.
# Use it in a BASIC file with: tokenfile ultrabasic-64
# BASIC V2's keywords are here too, so the longest keyword that matches is the one taken.
# Its programs start at $2C01, not $0801: build them with that load address.
# Left out, as they're only symbols (so * stays BASIC V2's multiply): [ ]

END, 80
FOR, 81
NEXT, 82
DATA, 83
INPUT#, 84
INPUT, 85
DIM, 86
READ, 87
LET, 88
GOTO, 89
