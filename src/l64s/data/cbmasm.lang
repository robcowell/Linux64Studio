<?xml version="1.0" encoding="UTF-8"?>
<!-- GtkSourceView 5 language definition for CBM prg Studio-style 6502 assembler -->
<language id="cbmasm" name="6502 Assembler (CBM prg Studio)" version="2.0" _section="Source">
  <metadata>
    <property name="globs">*.asm;*.s;*.a;*.inc</property>
    <property name="line-comment-start">;</property>
  </metadata>

  <styles>
    <style id="comment" name="Comment" map-to="def:comment"/>
    <style id="todo" name="TODO" map-to="def:note"/>
    <style id="mnemonic" name="Mnemonic" map-to="def:keyword"/>
    <style id="directive" name="Directive" map-to="def:preprocessor"/>
    <style id="number" name="Number" map-to="def:number"/>
    <style id="string" name="String" map-to="def:string"/>
    <style id="label" name="Label" map-to="def:function"/>
    <style id="local" name="Local label" map-to="def:identifier"/>
    <style id="param" name="Macro parameter" map-to="def:special-constant"/>
    <style id="register" name="Register" map-to="def:type"/>
    <style id="macro-call" name="Macro call" map-to="def:builtin"/>
  </styles>

  <default-regex-options case-sensitive="false"/>

  <definitions>
    <context id="line-comment" style-ref="comment" end-at-line-end="true">
      <start>;|//</start>
      <include><context ref="def:in-comment"/></include>
    </context>
    <context id="block-comment" style-ref="comment">
      <start>/\*</start>
      <end>\*/</end>
      <include><context ref="def:in-comment"/></include>
    </context>
    <!-- CBM prg Studio's todo directive: the line is a task, not code -->
    <context id="todo-line" style-ref="comment" end-at-line-end="true">
      <start>^\s*(todo)\b</start>
      <include>
        <context sub-pattern="1" where="start" style-ref="todo"/>
      </include>
    </context>
    <context id="string-sq" style-ref="string" end-at-line-end="true">
      <start>'</start>
      <end>'</end>
    </context>
    <context id="string-dq" style-ref="string" end-at-line-end="true">
      <start>"</start>
      <end>"</end>
    </context>

    <context id="mnemonics" style-ref="mnemonic">
      <prefix>(?&lt;![\w@.])</prefix>
      <suffix>(?![\w@.])</suffix>
      <keyword>adc</keyword><keyword>and</keyword><keyword>asl</keyword><keyword>bcc</keyword>
      <keyword>bcs</keyword><keyword>beq</keyword><keyword>bit</keyword><keyword>bmi</keyword>
      <keyword>bne</keyword><keyword>bpl</keyword><keyword>brk</keyword><keyword>bvc</keyword>
      <keyword>bvs</keyword><keyword>clc</keyword><keyword>cld</keyword><keyword>cli</keyword>
      <keyword>clv</keyword><keyword>cmp</keyword><keyword>cpx</keyword><keyword>cpy</keyword>
      <keyword>dec</keyword><keyword>dex</keyword><keyword>dey</keyword><keyword>eor</keyword>
      <keyword>inc</keyword><keyword>inx</keyword><keyword>iny</keyword><keyword>jmp</keyword>
      <keyword>jsr</keyword><keyword>lda</keyword><keyword>ldx</keyword><keyword>ldy</keyword>
      <keyword>lsr</keyword><keyword>nop</keyword><keyword>ora</keyword><keyword>pha</keyword>
      <keyword>php</keyword><keyword>pla</keyword><keyword>plp</keyword><keyword>rol</keyword>
      <keyword>ror</keyword><keyword>rti</keyword><keyword>rts</keyword><keyword>sbc</keyword>
      <keyword>sec</keyword><keyword>sed</keyword><keyword>sei</keyword><keyword>sta</keyword>
      <keyword>stx</keyword><keyword>sty</keyword><keyword>tax</keyword><keyword>tay</keyword>
      <keyword>tsx</keyword><keyword>txa</keyword><keyword>txs</keyword><keyword>tya</keyword>
    </context>

    <context id="directives" style-ref="directive">
      <prefix>(?&lt;![\w@.])</prefix>
      <suffix>(?![\w@.])</suffix>
      <keyword>byte</keyword><keyword>byt</keyword><keyword>db</keyword><keyword>dfb</keyword>
      <keyword>word</keyword><keyword>wor</keyword><keyword>dw</keyword><keyword>text</keyword>
      <keyword>dcb</keyword><keyword>incbin</keyword><keyword>incasm</keyword><keyword>operator</keyword>
      <keyword>calc</keyword><keyword>hilo</keyword><keyword>align</keyword><keyword>org</keyword>
      <keyword>defm</keyword><keyword>endm</keyword><keyword>if</keyword><keyword>ifdef</keyword>
      <keyword>ifndef</keyword><keyword>else</keyword><keyword>endif</keyword><keyword>equ</keyword>
      <keyword>BasicUpstart</keyword><keyword>import</keyword><keyword>importonce</keyword>
      <keyword>macro</keyword><keyword>const</keyword><keyword>var</keyword><keyword>pc</keyword>
    </context>

    <context id="kickass-directive" style-ref="directive">
      <match>[.#][A-Za-z]+\b</match>
    </context>

    <context id="register" style-ref="register">
      <match>(?&lt;=,)\s*[xy]\b</match>
    </context>

    <context id="param" style-ref="param">
      <match>(?&lt;![\w)$])/[1-9](?!\d)</match>
    </context>

    <context id="local-label" style-ref="local">
      <match>@[A-Za-z_][A-Za-z0-9_]*</match>
    </context>

    <context id="label-def" style-ref="label">
      <match>^[A-Za-z_][A-Za-z0-9_.]*:?</match>
    </context>

    <context id="macro-call" style-ref="macro-call">
      <match extended="true">(?&lt;=^\s)\s*[A-Z][A-Z0-9]*_[A-Z0-9_]+\b</match>
    </context>

    <context id="number" style-ref="number">
      <match>(\$[0-9a-f]+|%[01]+|\b[0-9]+\b)</match>
    </context>

    <context id="cbmasm" class="no-spell-check">
      <include>
        <context ref="todo-line"/>
        <context ref="line-comment"/>
        <context ref="block-comment"/>
        <context ref="string-sq"/>
        <context ref="string-dq"/>
        <context ref="label-def"/>
        <context ref="local-label"/>
        <context ref="mnemonics"/>
        <context ref="directives"/>
        <context ref="kickass-directive"/>
        <context ref="macro-call"/>
        <context ref="param"/>
        <context ref="register"/>
        <context ref="number"/>
      </include>
    </context>
  </definitions>
</language>
